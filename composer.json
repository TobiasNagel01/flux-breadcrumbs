{
    "name": "tobiasnagel/flux-breadcrumbs",
    "description": "Route-driven breadcrumbs for Laravel applications rendered with Flux UI.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "livewire", "flux", "breadcrumbs"],
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/view": "^13.0"
    },
    "suggest": {
        "livewire/flux": "Required to render the bundled breadcrumbs view (^2.0)."
    },
    "autoload": {
        "psr-4": {
            "TobiasNagel\\FluxBreadcrumbs\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "TobiasNagel\\FluxBreadcrumbs\\FluxBreadcrumbsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
